# Server-side Groq API key used by PortfolioBot (/api/chat)
# Optional: If omitted, the companion bot gracefully falls back to the local deterministic response engine
GROQ_API_KEY=your_groq_api_key_here

# Optional: Override default Groq model (defaults to openai/gpt-oss-120b, with automatic fallback)
# GROQ_MODEL=openai/gpt-oss-120b

